+const root='/savesth143';
+export const validName=name=>typeof name==='string'&&(/^(?:scoreth143\.dat|th143\.cfg)$/.test(name)||/^replay\/th143_(?:[0-9]{2}|ud[^/\\\x00]{4})\.rpy$/.test(name)||/^savedata\/sc(?:0[1-9]|10)_(?:0[1-9]|10)\.dat$/.test(name));
+export function filePath(path){const name=typeof path==='string'&&path.startsWith(root+'/')?path.slice(root.length+1):path;if(!validName(name))throw Error('Invalid TH143 save path');return root+'/'+name;}
+export const digest=async bytes=>[...new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))].map(v=>v.toString(16).padStart(2,'0')).join('');
+export class BinaryGameFileStoreV2{
+ constructor(){this.database=null;}
+ async open(){this.database=await new Promise((resolve,reject)=>{const r=indexedDB.open(root,21);r.onupgradeneeded=()=>{const db=r.result,store=db.objectStoreNames.contains('FILE_DATA')?r.transaction.objectStore('FILE_DATA'):db.createObjectStore('FILE_DATA');if(!store.indexNames.contains('timestamp'))store.createIndex('timestamp','timestamp',{unique:false});for(const path of [root,root+'/replay',root+'/savedata'])store.put({mode:16877,timestamp:new Date()},path);};r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error);r.onblocked=()=>reject(Error('Save database upgrade blocked'));});this.database.onversionchange=()=>this.close();return this;}
+ async readAll(){const tx=this.database.transaction('FILE_DATA'),s=tx.objectStore('FILE_DATA'),keys=s.getAllKeys(),rows=s.getAll();await this.complete(tx);const files=new Map;for(let i=0;i<rows.result.length;i++){const row=rows.result[i];if((row.mode&0xf000)!==0x8000)continue;const name=keys.result[i].slice(root.length+1);if(!validName(name))continue;const bytes=new Uint8Array(row.contents).slice();if(bytes.length>0x4000000)throw Error('Invalid saved file size');files.set(name,{bytes,sha256:await digest(bytes)});}return files;}
+ complete(tx){return new Promise((yes,no)=>{tx.oncomplete=yes;tx.onabort=()=>no(tx.error||Error('Save transaction aborted'));tx.onerror=()=>{};});}
+ async write(files){const records=[];for(const[name,input]of files){const path=filePath(name);if(input.byteLength>0x4000000)throw Error('Invalid saved file size');records.push({name,path,bytes:new Uint8Array(input).slice()});}for(const r of records)r.sha256=await digest(r.bytes);await new Promise((yes,no)=>{const tx=this.database.transaction('FILE_DATA','readwrite');let enqueueError;tx.oncomplete=yes;tx.onabort=()=>no(enqueueError??tx.error??Error('Save transaction aborted'));tx.onerror=()=>{};try{const store=tx.objectStore('FILE_DATA');for(const r of records)store.put({mode:33188,timestamp:new Date(),contents:r.bytes},r.path);}catch(error){enqueueError=error;tx.abort();}});return records.map(r=>({name:r.name,sha256:r.sha256,bytes:r.bytes.length}));}
+ async remove(name){const path=filePath(name),tx=this.database.transaction('FILE_DATA','readwrite');tx.objectStore('FILE_DATA').delete(path);await this.complete(tx);}
+ close(){this.database?.close();this.database=null;}
+}
