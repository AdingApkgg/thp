@@ -0,0 +1,16 @@
+import {parse} from 'parse5';
+/** Parse rendered DOM attributes; script/style text is never markup. */
+export function deployedHtmlReferences(html) {
+ const references=[];
+ function visit(node){
+  for(const attribute of node.attrs??[])if(attribute.name==='src'||attribute.name==='href')references.push(attribute.value);
+  for(const child of node.childNodes??[])visit(child);
+ }
+ visit(parse(html));return references;
+}
+/** Resolve canonical directory documents without accepting missing assets. */
+export function deploymentReferencePath(path, inventory){
+ if(inventory.has(path))return path;
+ const directory=path.replace(/\/?$/,'/')+'index.html';
+ return inventory.has(directory)?directory:null;
+}
