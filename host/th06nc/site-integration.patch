diff --git a/launcher/app/services/publication-metadata-cache.ts b/launcher/app/services/publication-metadata-cache.ts
new file mode 100644
index 000000000..ba7d4b522
--- /dev/null
+++ b/launcher/app/services/publication-metadata-cache.ts
@@ -0,0 +1,32 @@
+import {validateSiteManifest, type SiteManifest} from '../../src/contracts/site-manifest.mts';
+import {validateReleaseCatalog, type ReleaseCatalog} from '../../src/contracts/release-catalog.mts';
+
+const schema = 'eagler-touhou/publication-metadata/1';
+const rootFor = (baseUrl: string) => new URL('./', baseUrl).href;
+const keyFor = (root: string) => schema + ':' + root;
+export interface CachedPublicationMetadata {siteManifest: SiteManifest | null; releaseCatalog: ReleaseCatalog | null}
+
+/** Cache only validated publication metadata, scoped to the exact origin/mount.
+ * Installed bytes and Runtime generations retain their own integrity owners. */
+export function readPublicationMetadata(storage: Storage | null, baseUrl: string): CachedPublicationMetadata {
+  const empty = {siteManifest: null, releaseCatalog: null};
+  try {
+    const root = rootFor(baseUrl), raw = storage?.getItem(keyFor(root));
+    if (!raw || raw.length > 2 * 1024 * 1024) return empty;
+    const value = JSON.parse(raw);
+    if (value?.schema !== schema || value.root !== root) return empty;
+    let siteManifest: SiteManifest | null = null, releaseCatalog: ReleaseCatalog | null = null;
+    try {if (value.siteManifest) siteManifest = validateSiteManifest(value.siteManifest);} catch {}
+    try {if (value.releaseCatalog) releaseCatalog = validateReleaseCatalog(value.releaseCatalog);} catch {}
+    return {siteManifest, releaseCatalog};
+  } catch {return empty;}
+}
+
+export function writePublicationMetadata(storage: Storage | null, baseUrl: string, value: CachedPublicationMetadata) {
+  try {
+    const root = rootFor(baseUrl);
+    storage?.setItem(keyFor(root), JSON.stringify({schema, root,
+      siteManifest: value.siteManifest ? validateSiteManifest(value.siteManifest) : null,
+      releaseCatalog: value.releaseCatalog ? validateReleaseCatalog(value.releaseCatalog) : null}));
+  } catch { /* Storage availability never blocks online or installed launch. */ }
+}
